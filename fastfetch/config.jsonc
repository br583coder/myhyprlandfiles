{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    {
     "type": "os",
     "format": "Prism (btw)"
    },
    "host",
    {
     "type": "kernel",
     "format": "Linux lqx (im different)"
    },
    "uptime",
    "packages",
    "shell",
    "display",
    {
     "type": "wm",
     "format": "Hyprland (switch back to hyprlang)"
    },
    "icons",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}
